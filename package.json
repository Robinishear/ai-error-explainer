{
  "name": "ai-error-explainer",
  "publisher": "robinishear",
  "displayName": "ai-error-explainer",
  "description": "AI-powered error explanations on hover",
  "version": "1.3.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.133.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-error-explainer.helloWorld",
        "title": "Hello World",
        "category": "AI Error Explainer"
      }
    ],
    "configuration": {
      "title": "AI Error Explainer",
      "properties": {
        "aiErrorExplainer.apiFormat": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "gemini",
            "anthropic"
          ],
          "enumDescriptions": [
            "Works with OpenAI, DeepSeek, Groq, Mistral, OpenRouter, Together, xAI, and most other providers",
            "Google Gemini (different format)",
            "Anthropic Claude (different format)"
          ],
          "default": "openai-compatible",
          "description": "Which API format your provider uses"
        },
        "aiErrorExplainer.baseUrl": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1/chat/completions",
          "description": "Only used when API Format = openai-compatible. The full endpoint URL for your provider (e.g. https://api.groq.com/openai/v1/chat/completions)"
        },
     "aiErrorExplainer.model": {
  "type": "string",
  "default": "",
  "description": "The model name your provider expects (e.g. gpt-4o-mini, llama-3.3-70b-versatile, deepseek-chat). Leave empty to use the default free OpenRouter model."
},
        "aiErrorExplainer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your API key for the configured provider"
        },
        "aiErrorExplainer.language": {
          "type": "string",
          "enum": [
            "English",
            "বাংলা",
            "Hindi",
            "Urdu",
            "Arabic",
            "Persian",
            "Chinese",
            "Japanese",
            "Korean",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Russian",
            "Turkish",
            "Indonesian",
            "Tamil",
            "Vietnamese",
            "Malay",
            "Thai",
            "Telugu",
            "Marathi",
            "Gujarati",
            "Punjabi",
            "Kannada",
            "Malayalam",
            "Bengali",
            "Dutch",
            "Italian",
            "Polish",
            "Ukrainian",
            "Romanian",
            "Greek",
            "Hebrew",
            "Swedish",
            "Danish",
            "Norwegian",
            "Finnish",
            "Czech",
            "Hungarian",
            "Filipino",
            "Swahili"
          ],
          "default": "English",
          "description": "Which language should the AI explanation be displayed in?"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-no-dotenv": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.133.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24"
  }
}

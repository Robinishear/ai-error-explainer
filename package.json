{
  "name": "ai-error-explainer",
  "displayName": "ai-error-explainer",
  "description": "AI-powered error explanations on hover",
  "version": "1.2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.133.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-error-explainer.helloWorld",
        "title": "Hello World",
        "category": "AI Error Explainer"
      }
    ],
    "configuration": {
      "title": "AI Error Explainer",
      "properties": {
        "aiErrorExplainer.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "gemini",
            "anthropic",
            "deepseek"
          ],
          "enumDescriptions": [
            "OpenRouter (access any model, free or paid)",
            "OpenAI (GPT models)",
            "Google Gemini",
            "Anthropic (Claude)",
            "DeepSeek"
          ],
          "default": "openrouter",
          "description": "Which AI provider to use — pick based on which API key you have"
        },
        "aiErrorExplainer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your API key for the selected provider above"
        },
        "aiErrorExplainer.openrouterModel": {
          "type": "string",
          "default": "nvidia/nemotron-3.5-lightning:free",
          "description": "Only used when provider = openrouter. Any OpenRouter model ID (e.g. openai/gpt-4o, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat)"
        },
        "aiErrorExplainer.language": {
          "type": "string",
          "enum": [
            "English",
            "বাংলা",
            "Hindi",
            "Urdu",
            "Arabic",
            "Persian",
            "Chinese",
            "Japanese",
            "Korean",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Russian",
            "Turkish",
            "Indonesian",
            "Tamil",
            "Vietnamese"
          ],
          "default": "English",
          "description": "Which language should the AI explanation be displayed in?"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-no-dotenv": "^13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.133.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24"
  }
}